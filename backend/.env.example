# =============================================================================
# QualiSync 后端环境变量配置
# =============================================================================
# 使用说明：
# 1. 复制本文件为 .env：  cp .env.example .env
# 2. 根据实际环境填写各项配置
# 3. .env 文件已在 .gitignore 中，不会被提交到代码仓库
# =============================================================================

# ── 服务地址 ──────────────────────────────────────────────
BE_URL=0.0.0.0:5010

# ── 主数据库连接 ──────────────────────────────────────────
# PostgreSQL 连接字符串
# 格式: postgresql+psycopg2://用户名:密码@主机:端口/数据库名
SPARKATP_SQL_URI=postgresql+psycopg2://postgres:your_password@127.0.0.1:5432/qualisync

# ── 多环境数据库配置（JSON 格式） ────────────────────────
# 如需配置多环境数据库，使用 JSON 格式，示例：
# EXECUTE_DB_CONFIG_JSON={"YOUR_TEAM":{"st":{"host":"127.0.0.1","port":5432,"user":"postgres","password":"your_password","database":"qualisync_st"}}}
EXECUTE_DB_CONFIG_JSON=

# ── 团队列表 ──────────────────────────────────────────────
# 逗号分隔的团队名称
USE_TEAM=

# ── 外部服务地址 ──────────────────────────────────────────
STRESS_URI=
QE_DOMAIN=

# ── 安全 ─────────────────────────────────────────────────
# 应用内部密码（用于特定接口鉴权等）
APP_PASSWORD=

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Jenkins（可选，如不需要可留空） ──────────────────────
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_DEFAULT_JOB=pytest-auto-runner
PERFORMANCE_JENKINS_JOB=performance-runner
PERFORMANCE_JENKINS_VIEW_URL=
PRECISE_JENKINS_JOB=precise-test-runner
AUTOMATION_CALLBACK_SECRET=

# ── 平台地址 ──────────────────────────────────────────────
PLATFORM_BASE_URL=http://127.0.0.1:5010/it/api

# ── AI 模块配置 ───────────────────────────────────────────
AI_WORKSPACE_ROOTS=
AI_DEFAULT_TIMEOUT_SECONDS=300
AI_MAX_OUTPUT_BYTES=1048576

# ── 移动自动化（可选） ───────────────────────────────────
MOBILE_AUTOMATION_ROOT=
MOBILE_AUTOMATION_PYTHON=python3
MOBILE_AUTOMATION_TIMEOUT_SECONDS=1800
MOBILE_AUTOMATION_MAX_PARALLEL_DEVICES=1
MOBILE_AUTOMATION_ADB_PATH=adb
MOBILE_AUTOMATION_APPIUM_URL=http://127.0.0.1:4723
MOBILE_AUTOMATION_APPIUM_BIN=appium

# ── 飞书通知（可选） ─────────────────────────────────────
FEISHU_WEBHOOK_URL=

# =============================================================================
# AI 大模型配置（参见 config/ai_config.py）
# =============================================================================

# OpenAI API 配置
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_TOKENS=4096
# OPENAI_TEMPERATURE=0.7

# 自定义 API 配置（兼容 OpenAI 格式的第三方 API）
# CUSTOM_API_KEY=
# CUSTOM_API_BASE=
# CUSTOM_MODEL=

# 模型提供商：openai, custom
# MODEL_PROVIDER=custom

# 超时配置（秒）
# AI_CONNECT_TIMEOUT=60
# AI_READ_TIMEOUT=300

# 重试配置
# AI_MAX_RETRIES=3
# AI_RETRY_DELAY=2.0
